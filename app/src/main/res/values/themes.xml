<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PronosticiCalcio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.PronosticiCalcio.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PronosticiCalcio.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.PronosticiCalcio.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>
</resources>
